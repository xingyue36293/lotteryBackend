# 应用
APP_NAME=Lottery Aggregator
DEBUG=true
# CORS，JSON 数组格式
CORS_ORIGINS=["*"]

# ---- 上游数据源地址 ----
# 168yyy.net：极速赛车 / 澳洲幸运5 等 gid 体系彩种
YYY168_BASE_URL=https://www.168yyy.net
# api.apiote122.com：幸运时时彩 / 台湾5分彩 等
APIOTE122_BASE_URL=https://api.apiote122.com
# 168 线路池：北京PK10 / 幸运飞艇 / SG飞艇 / 英国乐透10，JSON 数组，按顺序重试
PKS_BASE_URLS=["https://1688455.com","https://1688507.com","https://1689690.com","https://1689691.com","https://1689687.com"]
# api.chuanqiking.com：哈希分分彩 / 奇趣腾讯分分彩 等
CHUANQIKING_BASE_URL=https://api.chuanqiking.com

# ---- 上游请求策略 ----
UPSTREAM_TIMEOUT=8
UPSTREAM_RETRIES=2
UPSTREAM_RETRY_DELAY=0.3
UPSTREAM_VERIFY_SSL=true
# 证书验证失败时改用系统证书库（truststore）
UPSTREAM_USE_TRUSTSTORE=true

# ---- 连接池 ----
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# ---- 缓存（秒）----
# 仅缓存 latest：过期时间 = 下一期开奖时间，下期缺失/异常时回退 CACHE_LATEST_TTL
# history 不缓存
CACHE_LATEST_TTL=3
# 单条缓存最长存活时间（防御上游下期时间异常）
CACHE_MAX_TTL=300
CACHE_MAXSIZE=2048

# ---- 历史条数 ----
HISTORY_DEFAULT_LIMIT=50
HISTORY_MAX_LIMIT=200
